# WARNING: Commenting after a variable's value DOES NOT WORK in .env files.
# In other words, don't do this: `FOO=value # this is a comment`.
# This would give the value "value # this is a comment" to the FOO variable.
# Use single-line comments instead:
# ```
#   # this is a comment:
#   FOO=value
# ```

# ===== Pi Network API Configuration =====
# Obtain these from the Pi Developer Portal (develop.pi in the Pi Browser)

PI_API_URL=https://api.minepi.com
PI_API_KEY=your_pi_api_key_here
PI_SECRET_KEY=your_webhook_secret_key_here
PI_PUBLIC_KEY=your_public_key_for_signature_verification

# ===== Server Configuration =====
NODE_ENV=production
PORT=3000

# ===== API Security =====
# Generate a random 32-byte token for API authentication
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=generate_random_secure_token_here

# ===== Database Configuration (Optional) =====
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pay_with_pi
# DB_USER=postgres
# DB_PASSWORD=your_db_password

# ===== Logging Configuration (Optional) =====
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ===== Feature Flags =====
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
